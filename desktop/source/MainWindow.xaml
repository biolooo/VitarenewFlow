<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VitarenewFlow · Desktop" Width="1320" Height="860" MinWidth="1120" MinHeight="760"
        Background="#0B1016" Foreground="#EDF3F7" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#64E8C4"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#D9E5ED"/><Setter Property="Background" Value="#1B2733"/>
   <Setter Property="BorderBrush" Value="#2A3947"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#64E8C4"/><Setter Property="Foreground" Value="#0D2823"/><Setter Property="BorderBrush" Value="#64E8C4"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#141E28"/><Setter Property="Foreground" Value="#EEF4F8"/><Setter Property="CaretBrush" Value="#64E8C4"/>
   <Setter Property="BorderBrush" Value="#293744"/><Setter Property="Padding" Value="12,10"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" CornerRadius="10" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#64E8C4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#354451" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#243440"/><Setter Property="Foreground" Value="#EDF3F7"/><Setter Property="BorderBrush" Value="#405666"/><Setter Property="Padding" Value="10"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#94A8B8"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
 </Window.Resources>
 <Grid Background="#0B1016">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="65"/></Grid.RowDefinitions>
  <Border BorderBrush="#22303D" BorderThickness="0,0,0,1" Background="#101821">
   <Grid Margin="26,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Image x:Name="BrandIcon" Width="38" Height="38" Margin="0,0,13,0"/>
    <StackPanel><TextBlock Text="VitarenewFlow" FontWeight="Bold" FontSize="16"/><TextBlock Text="DESKTOP COMPANION  /  0.3.1" Foreground="#94A8B8" FontSize="10" Margin="0,3,0,0"/></StackPanel>
   </StackPanel>
   <Border Background="#182B28" CornerRadius="16" Padding="14,8" HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Fill="#64E8C4" Width="7" Height="7" Margin="0,0,8,0"/><TextBlock x:Name="CardLabel" Text="SD-Karte verbunden" FontSize="12" Foreground="#98E4CF"/></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/><ColumnDefinition Width="296"/></Grid.ColumnDefinitions>
   <Border Background="#101821" BorderBrush="#22303D" BorderThickness="0,0,1,0">
    <Grid Margin="14,24,14,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="DEINE SAMMLUNG" FontSize="10" FontWeight="SemiBold" Foreground="#6F889A" Margin="12,0,0,14"/>
     <StackPanel x:Name="Navigation" Grid.Row="1"/>
     <StackPanel Grid.Row="2">
      <Button x:Name="AutoCovers" Content="Fehlende Cover laden" FontSize="11" Padding="8,11" ToolTip="Alle Kategorien durchsuchen · vorhandene Cover behalten · automatisch auf max.256 Pixel komprimieren"/>
      <TextBlock Text="Alle Kategorien · max. 256 px" Foreground="#7E97A8" FontSize="10" Margin="5,6,0,8"/>
      <Border BorderBrush="#253441" BorderThickness="0,1,0,0" Padding="10,17,8,17"><StackPanel><TextBlock Text="PC weiterspielen" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Emulatoren und Save-Austausch planen wir im nächsten Schritt." Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
      <Button x:Name="OpenCard" Content="SD im Explorer öffnen" FontSize="11" Padding="8,11"/>
      <Button x:Name="OpenBackups" Content="Cover-Backups öffnen" FontSize="11" Padding="8,10" Margin="0,8,0,0"/>
      <Button x:Name="SetupLauncher" Content="Einrichtung auf dem 3DS" FontSize="11" Padding="8,10" Margin="0,8,0,0" ToolTip="Updates und Downloads direkt in VitarenewFlow"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="26,23,20,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock x:Name="Heading" Text="Deine Spiele." FontWeight="SemiBold" FontSize="28"/><TextBlock x:Name="Summary" Text="Deine Sammlung auf einen Blick." Style="{StaticResource Muted}" Margin="0,5,0,21" FontSize="12"/></StackPanel><Button x:Name="Refresh" Content="↻" ToolTip="Karte neu einlesen" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="22" Padding="13,5"/></Grid>
    <Grid Grid.Row="1" Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid><TextBox x:Name="Search" ToolTip="Nach Titel oder Dateiname suchen" Margin="0,0,12,0"/><TextBlock x:Name="SearchHint" Text="Spiel suchen …" Foreground="#7E95A8" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
     <Button x:Name="AddGames" Grid.Column="1" Content="+  Spiele hinzufügen" Style="{StaticResource Primary}"/>
    </Grid>
    <Grid Grid.Row="2">
     <ListBox x:Name="Games" Background="Transparent" Foreground="#EDF3F7" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" HorizontalContentAlignment="Stretch" SelectionMode="Single" Padding="0" Margin="-3,0,0,0">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="3,0,9,13"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="#141E28" CornerRadius="13" BorderThickness="1" BorderBrush="#253340"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#64E8C4"/><Setter TargetName="Tile" Property="Background" Value="#1B302E"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#6B8B99"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#64E8C4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel Width="166" Margin="9,9,9,12">
       <Border Height="174" Background="#0F1720" CornerRadius="8" ClipToBounds="True"><Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding System}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#658092"/><TextBlock Text="Kein Cover" FontSize="11" Foreground="#6F8799" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel>
        <Image Source="{Binding Cover}" Opacity="{Binding ArtOpacity}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Cover}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
        <Border Background="#0F1720"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Cover}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding System}" HorizontalAlignment="Center" FontSize="23" FontWeight="Bold" Foreground="#658092"/><TextBlock Text="Kein Cover" HorizontalAlignment="Center" FontSize="11" Foreground="#7B91A1" Margin="0,7,0,0"/></StackPanel></Border>
       </Grid></Border>
       <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="36" LineHeight="18" Margin="1,11,1,0" ToolTip="{Binding Key}"/>
       <TextBlock Text="{Binding Caption}" FontSize="10" Foreground="#91A7B6" Margin="1,7,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Border x:Name="Empty" Visibility="Collapsed" BorderBrush="#2C3C49" BorderThickness="1" CornerRadius="14" Padding="24" VerticalAlignment="Top"><StackPanel><TextBlock Text="Platz für neue Abenteuer." FontSize="20" FontWeight="SemiBold"/><TextBlock Text="ROM-Dateien hierher ziehen oder oben Spiele hinzufügen wählen. Die Plattform erkennen wir automatisch." Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="ROMs hierher ziehen · Cover auf ein Spiel ziehen · Änderungen am 3DS neu einlesen" Foreground="#7E97A8" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
   </Grid>
   <Border Grid.Column="2" Background="#101821" BorderBrush="#22303D" BorderThickness="1,0,0,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="21,25,21,20">
     <TextBlock Text="AUSGEWÄHLTES SPIEL" Foreground="#6F889A" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,17"/>
     <Border Height="230" CornerRadius="12" Background="#19242F"><Grid><TextBlock x:Name="DetailPlaceholder" Text="Wähle ein Spiel" Foreground="#7E97A8" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="DetailCover" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></Border>
     <TextBlock x:Name="DetailTitle" Text="Deine nächste Session." FontWeight="SemiBold" FontSize="20" TextWrapping="Wrap" Margin="0,17,0,7"/>
     <TextBlock x:Name="DetailPlatform" Foreground="#64E8C4" FontSize="12"/>
     <Button x:Name="ChangeCover" Content="Cover hinzufügen" Style="{StaticResource Primary}" Margin="0,19,0,8" IsEnabled="False"/>
     <TextBlock Text="PNG oder JPG · passend verkleinert · vorheriges Cover wird gesichert" Foreground="#7E97A8" FontSize="10" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,14"/>
     <Button x:Name="OpenGameFolder" Content="Spieldatei im Explorer" Padding="9,10" FontSize="12" IsEnabled="False"/>
     <TextBlock Text="DATEI / TITEL-ID" Foreground="#6F889A" FontSize="10" FontWeight="SemiBold" Margin="0,22,0,7"/>
     <TextBlock x:Name="DetailFile" Style="{StaticResource Muted}" FontSize="11" TextWrapping="WrapWithOverflow"/>
     <TextBlock x:Name="DetailNote" Foreground="#7E97A8" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,9,0,0"/>
     <Border BorderBrush="#263744" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,15,0,0"><StackPanel>
      <TextBlock Text="SPIELSTÄNDE" Foreground="#6F889A" FontSize="10" FontWeight="SemiBold"/>
      <TextBlock x:Name="SaveInfo" Text="Bekannte Speicherorte werden nur gelesen." Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,10"/>
      <Button x:Name="OpenSave" Content="Spielstand-Ordner öffnen" FontSize="11" Padding="8,9" Visibility="Collapsed"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#121E27" BorderBrush="#2B3C48" BorderThickness="0,1,0,0">
   <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="Status" Text="Bereit. Spiele hinzufügen oder ein Cover auswählen." VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="#B8CAD5" Margin="0,0,15,0"/>
    <ProgressBar x:Name="Progress" Grid.Column="1" Height="5" Background="#283E49" Foreground="#64E8C4" BorderThickness="0" VerticalAlignment="Center" Visibility="Collapsed"/>
    <Button x:Name="CancelImport" Grid.Column="2" Content="Abbrechen" Margin="15,0,0,0" Padding="12,8" Visibility="Collapsed"/>
   </Grid>
  </Border>
 </Grid>
</Window>


